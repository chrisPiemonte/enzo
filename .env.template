# Copy to .env and edit. Each block is read by one component; its prefix is the component's name.

# ── Shared by every service ──────────────────────────────────────────────────
# Signs and verifies identity tokens. Demo value: change it for anything beyond a laptop.
IDENTITY_SECRET=dev-only-secret-change-me

# ── Local agent (enzo/src/enzo/config.py) ───────────────────────────────────
AGENT_USER=user:maria
AGENT_ID=agent:triage
AGENT_MODEL_ALIAS=triage-default
AGENT_GATEWAY_URL=http://localhost:8000
# System prompt: name, and a version number or an alias (see data/context/prompts/<name>/aliases.yaml).
AGENT_PROMPT=triage-system
AGENT_PROMPT_VERSION=production
AGENT_PROMPTS_DIR=data/context/prompts
AGENT_IDENTITY_FILE=data/context/identity.yaml
# Tracing: one MLflow experiment per service.
AGENT_MLFLOW_URL=http://localhost:5001
AGENT_EXPERIMENT=enzo
# Adapter switches, one per port.
AGENT_GATEWAY=http          # http | mock (mock = whole gateway scripted, works offline)
AGENT_AUDIT=mock
AGENT_PROMPTS=file

# ── Model gateway (services/gateway/src/gateway/settings.py) ───────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_CONFIG=services/gateway/gateway.yaml
# Provider URLs when the gateway runs locally (`uv run gateway`):
#   native Ollama    -> http://localhost:11434
#   container Ollama -> http://localhost:11435
GATEWAY_OPENAI_URL=http://localhost:11434/v1
GATEWAY_ANTHROPIC_URL=http://localhost:11434
# Tracing: one MLflow experiment per service (compose overrides the URL inside Docker).
GATEWAY_MLFLOW_URL=http://localhost:5001
GATEWAY_EXPERIMENT=gateway

# ── Docker Compose (docker-compose.yml) ──────────────────────────────────────
# Ollama seen from the gateway container (both providers point here):
#   native Ollama    -> http://host.docker.internal:11434   (default: Metal GPU, ~5 s per turn)
#   container Ollama -> http://ollama:11434                 (no native install needed, CPU only, 30 s+ per turn)
GATEWAY_DOCKER_OLLAMA_URL=http://host.docker.internal:11434
# Host folder holding the models, shared by every Ollama container.
OLLAMA_MODELS_DIR=./data/runtime/ollama/models
